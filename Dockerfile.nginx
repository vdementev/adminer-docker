# DRIVERS=all builds every database Adminer supports. DRIVERS=mysql builds the
# MySQL/MariaDB-only image: upstream's MySQL-only adminer.php, no driver
# plugins, no extra extensions, no Oracle Instant Client.
ARG DRIVERS=all

# Oracle's Instant Client is ~100 MB of the image and only the (beta) Oracle
# driver needs it — build with --build-arg WITH_ORACLE=false to drop it.
ARG WITH_ORACLE=true

FROM lotuswebagency/php:8.5-ext-builder AS ext-all
ARG WITH_ORACLE
COPY build/ext.sh /usr/local/bin/build-ext
RUN sh /usr/local/bin/build-ext "$WITH_ORACLE"

FROM scratch AS ext-mysql
WORKDIR /out

FROM ext-${DRIVERS} AS ext

FROM lotuswebagency/php:8.5-fpm
ARG DRIVERS

# OCI metadata. CI adds revision/version/created on top of these.
LABEL org.opencontainers.image.title="adminer (nginx)" \
      org.opencontainers.image.description="Adminer 6 with every driver it supports — nginx + php-fpm on :8080. Parallel zstd/gzip dumps, native mysqldump/pg_dump export, fast restore." \
      org.opencontainers.image.url="https://hub.docker.com/r/dementev/adminer" \
      org.opencontainers.image.documentation="https://github.com/vdementev/adminer-docker#readme" \
      org.opencontainers.image.source="https://github.com/vdementev/adminer-docker" \
      org.opencontainers.image.vendor="Lotus Web Agency" \
      org.opencontainers.image.authors="Vasilii Dementev https://vasiliidementev.com" \
      org.opencontainers.image.licenses="MIT"

# nginx's master needs root to bind and drop to www-data, and php-fpm's pool
# switches to www-data itself.
USER root

COPY --from=ext /out/ /
COPY ./docker-entrypoint.sh /usr/local/bin/

# The base already carries the MySQL/MariaDB and PostgreSQL 18 clients, zstd,
# and the extensions for MySQL, PostgreSQL and SQLite. On top of that, all
# drivers adds MS SQL (pdo_dblib + FreeTDS), Oracle (oci8 + Instant Client)
# and MongoDB (the base's shared mongodb module). ClickHouse, Elasticsearch,
# Redis and SimpleDB speak HTTP or raw sockets and need no extension.
RUN set -eux; \
    apk add --no-cache \
        nginx-mainline \
        nginx-mainline-fastcgi-params \
        nginx-mainline-mime-types \
        mariadb-connector-c \
        pigz; \
    # The base's MariaDB client looks for its auth plugins in a directory no
    # package fills, so it cannot log in to MySQL 8's caching_sha2_password
    # accounts. mariadb-connector-c ships them; point the client there.
    printf '[client]\nplugin-dir=/usr/lib/mariadb/plugin\n' > /etc/my.cnf; \
    if [ "$DRIVERS" = "all" ]; then \
        apk add --no-cache freetds sqlite; \
        if [ -d /opt/oracle/instantclient ]; then apk add --no-cache libaio; ldconfig; fi; \
        php-ext-enable mongodb; \
    fi; \
    chmod +x /usr/local/bin/docker-entrypoint.sh; \
    rm -rf /usr/local/etc/php-fpm.d; \
    install -d -m 0777 -o www-data -g www-data /tmp/nginx/body /tmp/nginx/fastcgi_temp

# Config files
COPY ./conf/php.ini /usr/local/etc/php/conf.d/999-php.ini
COPY ./conf/www.conf /usr/local/etc/php-fpm.conf
COPY ./conf/nginx.conf /etc/nginx/nginx.conf
COPY --chown=www-data:www-data /app /app

RUN set -eux; \
    if [ "$DRIVERS" = "mysql" ]; then \
        mv /app/adminer-mysql.php /app/adminer.php; \
        rm -rf /app/adminer-drivers; \
    else \
        rm /app/adminer-mysql.php; \
    fi

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/ping.php || exit 1

EXPOSE 8080
# -s: stay a subreaper when something else (`init: true`) already is PID 1.
ENTRYPOINT ["/usr/bin/tini", "-s", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx"]
