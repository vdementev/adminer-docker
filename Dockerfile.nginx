FROM php:8.4-fpm-trixie
ENV IPE_ICU_EN_ONLY=1 \
    DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Oracle's Instant Client is ~100 MB of the image and only the (beta) Oracle
# driver needs it — build with --build-arg WITH_ORACLE=false to drop it.
ARG WITH_ORACLE=true

COPY ./docker-entrypoint.sh /usr/local/bin/

# Packages and PHP extensions. The extension list covers every database
# Adminer can talk to: MySQL/MariaDB (mysqli, pdo_mysql), PostgreSQL and
# CockroachDB (pgsql, pdo_pgsql), SQLite (bundled with the base image),
# MS SQL (sqlsrv/pdo_sqlsrv, pdo_dblib as the FreeTDS fallback), Oracle
# (oci8, pdo_oci) and MongoDB (mongodb, via the driver plugin). ClickHouse,
# Elasticsearch, Redis and SimpleDB drivers speak HTTP or raw sockets and
# need no extension of their own.
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        default-mysql-client \
        dumb-init \
        libnginx-mod-http-brotli-filter \
        libnginx-mod-http-brotli-static \
        nginx \
        pigz \
        sqlite3 \
        zstd; \
    # PostgreSQL client from PGDG, not Debian: trixie ships pg_dump 17, which
    # refuses to dump an 18+ server. 18 reads everything back to 9.2.
    install -d -m 0755 /etc/apt/keyrings; \
    curl -sSLf -o /etc/apt/keyrings/pgdg.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-client-18; \
    curl -sSLf -o /usr/local/bin/install-php-extensions \
        https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions; \
    chmod +x /usr/local/bin/install-php-extensions; \
    install-php-extensions \
        mongodb \
        mysqli \
        pdo_dblib \
        pdo_mysql \
        pdo_pgsql \
        pdo_sqlsrv \
        pgsql \
        sqlsrv \
        zip \
        zstd; \
    if [ "$WITH_ORACLE" = "true" ]; then install-php-extensions oci8 pdo_oci; fi; \
    chown -R www-data:www-data /var/lib/nginx /var/log/nginx; \
    chmod +x /usr/local/bin/docker-entrypoint.sh; \
    rm -rf /usr/local/etc/php-fpm.d/*; \
    rm -f /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini-production; \
    rm -f /usr/local/bin/install-php-extensions; \
    install -d -m 0777 -o www-data -g www-data /tmp/nginx/body /tmp/nginx/fastcgi_temp; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Copy config files
COPY ./conf/php.ini /usr/local/etc/php/conf.d/999-php.ini
COPY ./conf/www.conf /usr/local/etc/php-fpm.conf
COPY ./conf/nginx.conf /etc/nginx/nginx.conf
COPY --chown=www-data:www-data /app /app

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/ping.php || exit 1

EXPOSE 8080
ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["nginx"]
